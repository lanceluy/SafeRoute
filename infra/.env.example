DB_NAME=saferoute
DB_USER=saferoute
DB_PASSWORD=saferoute
# Required outside the dev profile. Generate with: openssl rand -base64 48
# Left empty, the dev profile falls back to a public development key.
JWT_SECRET=
# Controlled moderator provisioning: comma-separated account ids (UUIDs), promoted at startup
SAFEROUTE_MODERATOR_USER_IDS=
# Development convenience only (honoured by the dev/benchmark profiles): emails promoted to MODERATOR
SAFEROUTE_MODERATOR_EMAILS=mod@saferoute.local
# Reject reports outside the Metro Manila pilot area (set false to test elsewhere)
SAFEROUTE_COVERAGE_ENABLED=true
