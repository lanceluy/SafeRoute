import SwiftUI
 
// MARK: - View
 
struct ConsentView: View {
 
   /// Called with `true` if the user agreed, `false` if they declined.
   /// The caller decides what "declined" means for the rest of onboarding
   /// (e.g. limited, no-location browsing — see the privacy doc, Section 11).
   var onDecision: (Bool) -> Void
 
   @State private var hasAgreed = false
 
   var body: some View {
       ScrollView {
           VStack(alignment: .leading, spacing: 20) {
 
               header
 
               permissionRow(
                   systemImage: "location.fill",
                   titleKey: "consent.location.title",
                   bodyKey: "consent.location.body"
               )
 
               permissionRow(
                   systemImage: "camera.fill",
                   titleKey: "consent.photos.title",
                   bodyKey: "consent.photos.body"
               )
 
               permissionRow(
                   systemImage: "map.fill",
                   titleKey: "consent.reports.title",
                   bodyKey: "consent.reports.body"
               )
 
               legalNotice
 
               privacyPolicyLink
 
               agreeToggle
 
               actionButtons
           }
           .padding(24)
       }
       // Groups the whole screen as one region for VoiceOver so a user
       // swiping through doesn't have to traverse every decorative icon
       // separately before reaching the content that matters.
       .accessibilityElement(children: .contain)
   }
 
   // MARK: - Subviews
 
   private var header: some View {
       VStack(alignment: .leading, spacing: 4) {
           Text("consent.title", comment: "Consent screen heading, e.g. 'Before you start'")
               .font(.title2.bold())
               .accessibilityAddTraits(.isHeader)
 
           Text("consent.subtitle", comment: "Short explanation of why this screen exists")
               .font(.subheadline)
               .foregroundStyle(.secondary)
       }
   }
 
   private func permissionRow(systemImage: String, titleKey: String, bodyKey: String) -> some View {
       HStack(alignment: .top, spacing: 12) {
           Image(systemName: systemImage)
               .font(.title3)
               .foregroundStyle(.tint)
               // Decorative — the meaning is carried by the text next to it,
               // so VoiceOver should skip the icon itself.
               .accessibilityHidden(true)
               .frame(width: 28)
 
           VStack(alignment: .leading, spacing: 4) {
               Text(LocalizedStringKey(titleKey))
                   .font(.headline)
               Text(LocalizedStringKey(bodyKey))
                   .font(.body)
                   .foregroundStyle(.secondary)
                   .fixedSize(horizontal: false, vertical: true) // wrap correctly at large Dynamic Type sizes
           }
       }
       // Combine icon + title + body into a single VoiceOver stop instead
       // of three, so the row reads as one coherent sentence.
       .accessibilityElement(children: .combine)
   }
 
   private var legalNotice: some View {
       Text("consent.legal_notice", comment: "One-line note that data handling follows RA 10173")
           .font(.footnote)
           .foregroundStyle(.secondary)
   }
 
   private var privacyPolicyLink: some View {
       Button {
           // Present the full SafeRoute_Privacy_Policy_and_Consent content
           // (e.g. as a sheet rendering the same text as the markdown doc).
       } label: {
           Text("consent.view_full_policy", comment: "Link button to the full privacy policy")
               .font(.body.weight(.medium))
       }
       .accessibilityHint(Text("consent.view_full_policy.hint", comment: "VoiceOver hint: opens the full policy in a new screen"))
   }
 
   private var agreeToggle: some View {
       Toggle(isOn: $hasAgreed) {
           Text("consent.agree_checkbox", comment: "Checkbox label: 'I understand and agree to the above.'")
               .font(.body)
               .fixedSize(horizontal: false, vertical: true)
       }
       .toggleStyle(.switch)
       .accessibilityHint(Text("consent.agree_checkbox.hint", comment: "VoiceOver hint explaining what agreeing enables"))
   }
 
   private var actionButtons: some View {
       HStack(spacing: 16) {
           Button(role: .cancel) {
               onDecision(false)
           } label: {
               Text("consent.decline", comment: "Decline button")
                   .frame(maxWidth: .infinity)
           }
           .buttonStyle(.bordered)
           .accessibilityHint(Text("consent.decline.hint", comment: "VoiceOver hint: continues in limited mode without location sharing"))
 
           Button {
               onDecision(true)
           } label: {
               Text("consent.agree_continue", comment: "Primary continue button")
                   .frame(maxWidth: .infinity)
           }
           .buttonStyle(.borderedProminent)
           .disabled(!hasAgreed)
           // Disabled state needs its own VoiceOver explanation — otherwise
           // a screen reader user just hears "dimmed" with no reason why.
           .accessibilityHint(
               Text(hasAgreed
                    ? "consent.agree_continue.hint_enabled"
                    : "consent.agree_continue.hint_disabled",
                    comment: "VoiceOver hint for the continue button, changes once the checkbox is on")
           )
       }
       .font(.body.weight(.semibold))
   }
}
 
// MARK: - Preview
 
#Preview {
   ConsentView { agreed in
       print("User \(agreed ? "agreed" : "declined")")
   }
}
 
